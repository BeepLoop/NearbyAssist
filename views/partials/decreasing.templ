package partials

import (
	"nearbyassist/internal/utils"
	"strconv"
)

templ Decreasing(text string, amount int, percent float64) {
	<div>
		<p class="font-medium">{ text } </p>
		<p class="font-medium text-xl my-2">{ strconv.Itoa(amount) }</p>
		<p class="my-2 text-xs text-gray-500">Compared to last month </p>
		<div class="rounded-sm p-1 bg-red-200 w-min">
			<p class="flex gap-1 text-red-600 font-bold">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 fill-green-400">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"></path>
				</svg>
				{ utils.ToPercentageString(percent) }
			</p>
		</div>
	</div>
}
