package partials

import (
	"nearbyassist/internal/utils"
	"strconv"
)

templ Decreasing(text string, amount int, percent float64) {
	<div>
		<p class="font-semibold text-neutral-dark">{ text } </p>
		<p class="font-medium text-xl my-2 text-neutral-dark">{ strconv.Itoa(amount) }</p>
		<p class="my-2 text-xs text-neutral-gray">Compared to last month </p>
		<div class="rounded-sm p-1 bg-danger/25 w-min">
			<span class="flex gap-1 text-danger font-bold px-1">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 fill-danger">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"></path>
				</svg>
				{ utils.ToPercentageString(percent) }
			</span>
		</div>
	</div>
}
