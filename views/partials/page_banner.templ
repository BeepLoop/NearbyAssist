package partials

templ PageBanner(title, description string) {
	<div class="mb-4">
		<h1 class="text-2xl font-semibold flex gap-2 items-center text-neutral-dark">
			<div class="w-1.5 h-6 bg-primary rounded-sm"></div>
			{ title }
		</h1>
		<div class="mt-2">
			<p class="text-sm text-neutral-gray">{ description }</p>
		</div>
	</div>
}
