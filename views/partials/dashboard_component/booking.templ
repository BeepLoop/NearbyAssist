package dashboardcomponent

import (
	"fmt"
	"nearbyassist/internal/dto"
	"nearbyassist/internal/utils"
	"nearbyassist/views/partials"
	"strconv"
)

var loadBookingChart = templ.NewOnceHandle()

templ Booking(data dto.WeeklyBookingData) {
	<card class="w-full rounded-sm outline-1 outline-pale-gray hover:shadow-xl hover:outline-primary">
		@templ.JSONScript("bookingData", data)
		<div class="p-2">
			<!-- Title -->
			<span class="mb-2 flex items-center justify-between">
				<p class="text-xs font-medium text-neutral-gray">Bookings (last 7 days)</p>
				<div class="text-xs">
					@bookingsOffCanvas("weeklybookings") {
						<div class="flex items-center justify-between">
							<h2 class="font-medium text-xs text-neutral-dark">Bookings</h2>
							<p class="text-xs text-neutral-gray">Last 7 days</p>
						</div>
						<div class="mt-4">
							for _, booking := range data.Bookings {
								<div class="mb-2">
									@partials.CollapsableWithBody(partials.CollapsableProps{
										Title:    fmt.Sprintf("Vendor: %s", booking.Vendor.Name),
										EndText:  booking.CreatedAt,
										Expanded: false,
									}) {
										@offCanvasBookingData(booking)
									}
								</div>
							}
						</div>
					}
				</div>
			</span>
			<!-- Count -->
			<div class="flex items-baseline gap-2">
				if data.Difference >= 0 {
					@partials.TrendUp()
				} else {
					@partials.TrendDown()
				}
				<p class="text-4xl font-semibold text-neutral-dark">{ strconv.Itoa(data.Total) }</p>
				<p class="text-xs font-semibold text-neutral-gray">total</p>
			</div>
		</div>
		<div class="p-2">
			<!-- Chart -->
			<div id="bookingChart"></div>
			@loadBookingChart.Once() {
				<script src="/static/script/bookingChart.js"></script>
			}
		</div>
	</card>
}

templ bookingsOffCanvas(id string) {
	<div>
		<div x-data={ fmt.Sprintf("offCanvas('%s')", id) } x-init="init()" x-effect="syncStateWithURL()">
			<!-- offCanvas Button -->
			<button
				type="button"
				class="w-min cursor-pointer rounded-sm bg-primary p-1 pr-1.5 font-semibold whitespace-nowrap text-white outline-1 outline-pale-gray hover:opacity-75"
				x-on:click="open()"
			>
				<span class="flex items-center gap-1">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
						<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"></path>
					</svg>
					<p>List</p>
				</span>
			</button>
			<!-- offCanvas Backdrop -->
			<div
				x-cloak
				x-show="offCanvasOpen"
				x-on:keydown.esc.window="close()"
				x-on:click.self="close()"
				role="dialog"
				class="fixed inset-0 z-90 bg-neutral-gray/50"
			>
				<!-- offCanvas Sidebar -->
				<div
					x-cloak
					x-show="offCanvasOpen"
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="translate-x-full"
					x-transition:enter-end="translate-x-0"
					x-transition:leave="transition ease-in duration-200"
					x-transition:leave-start="translate-x-0"
					x-transition:leave-end="translate-x-full"
					role="document"
					class="fixed top-0 right-0 flex h-full w-lg flex-col overflow-y-scroll bg-white px-4 pt-4 pb-14 outline-1 outline-pale-gray"
				>
					<!-- Content -->
					{ children... }
				</div>
			</div>
		</div>
		<script>
            (function() {
                 document.addEventListener("alpine:init", () => {
                     Alpine.data("offCanvas", (id) => ({
                         offCanvasOpen: false,
                         init() {
                             const params = new URLSearchParams(window.location.search);
                             this.offCanvasOpen = params.get('offCanvas') === id;
                         },
                         open() {
                             this.offCanvasOpen = true;
                             const params = new URLSearchParams(window.location.search);
                             params.set('offCanvas', id);
                             history.replaceState({}, '', `${window.location.pathname}?${params}`);
                         },
                         close() {
                             this.offCanvasOpen = false;
                             const params = new URLSearchParams(window.location.search);
                             if (params.get('offCanvas') === id) {
                                 params.delete('offCanvas');
                                 history.replaceState({}, '', `${window.location.pathname}?${params}`);
                             }
                         },
                         syncStateWithURL() {
                             const params = new URLSearchParams(window.location.search);
                             this.offCanvasOpen = params.get('offCanvas') === id;
                         },
                     }))
                 })
             })();
        </script>
	</div>
}

templ offCanvasBookingData(booking dto.Booking) {
	<div class="">
		<h1 class="font-medium">Booking</h1>
		@partials.Divider()
		<div class="mt-2 flex gap-2">
			<span class="font-medium text-neutral-dark">ID:</span>
			<p class="text-neutral-gray">{ booking.Id }</p>
		</div>
		<div class="mt-2 flex gap-2">
			<span class="font-medium text-neutral-dark">Total:</span>
			<p class="text-neutral-gray">₱ { utils.FloatToString(booking.Cost) }</p>
		</div>
		<div class="mt-2 flex items-center gap-2">
			<span class="font-medium text-neutral-dark">Status:</span>
			@partials.BookingStatus(booking.Status)
		</div>
		if booking.Status != "done" {
			<div class="mt-2 flex gap-2">
				if booking.Status == "cancelled" {
					<span class="font-medium text-neutral-dark">Cancel Reason:</span>
				} else if booking.Status == "rejected" {
					<span class="font-medium text-neutral-dark">Reject Reason:</span>
				}
				<p class="text-neutral-gray">{ booking.CancelReason }</p>
			</div>
		}
		<div class="mt-2 flex gap-2">
			<span class="font-medium text-neutral-dark">Date Booked:</span>
			<p class="text-neutral-gray">{ booking.CreatedAt }</p>
		</div>
		<div class="mt-2 flex gap-2">
			<span class="font-medium text-neutral-dark">Date Scheduled:</span>
			<p class="text-neutral-gray">{ booking.ScheduledAt }</p>
		</div>
		<div class="mt-2 flex gap-2">
			if booking.Status == "cancelled" {
				<span class="font-medium text-neutral-dark">Date Cancelled:</span>
			} else if booking.Status == "rejected" {
				<span class="font-medium text-neutral-dark">Date Rejected:</span>
			} else if booking.Status == "confirmed" {
				<span class="font-medium text-neutral-dark">Date Confirmed:</span>
			} else if booking.Status == "done" {
				<span class="font-medium text-neutral-dark">Date Completed:</span>
			}
			<p class="text-neutral-gray">{ booking.UpdatedAt }</p>
		</div>
	</div>
	<!-- Service -->
	<div class="mt-4">
		<div class="flex justify-between">
			<h1 class="font-medium">Service</h1>
			<a
				href={ templ.URL(fmt.Sprintf("/admin/user-management/vendors/%s?tab=services&offCanvas=%s", booking.Vendor.Id, booking.Service.Id)) }
				class="cursor-pointer rounded-sm bg-primary px-2 py-1 text-xs text-white hover:opacity-75"
			>view</a>
		</div>
		@partials.Divider()
		<div class="mt-2">
			<span class="font-medium text-neutral-dark">Title:</span>
			<p class="text-neutral-gray">{ booking.Service.Title }</p>
		</div>
		<div class="mt-2">
			<span class="font-medium text-neutral-dark">Description:</span>
			<p class="text-neutral-gray">{ booking.Service.Description }</p>
		</div>
		<div class="mt-2">
			<span class="font-medium text-neutral-dark">Tags:</span>
			<div class="mt-1.5 flex gap-2">
				for _, tag := range booking.Service.Tags {
					@partials.DefaultBadgeSuccess(tag)
				}
			</div>
		</div>
		<div class="mt-2 flex gap-2">
			<span class="font-medium text-neutral-dark">Rate:</span>
			<p class="text-neutral-gray">{ utils.FormatCurrency(booking.Service.Price) }</p>
		</div>
		<div class="mt-2 flex gap-2">
			<span class="font-medium text-neutral-dark">Created At:</span>
			<p class="text-neutral-gray">{ booking.Service.CreatedAt }</p>
		</div>
		<div class="mt-2 flex gap-2">
			<span class="font-medium text-neutral-dark">Last Modified:</span>
			<p class="text-neutral-gray">{ booking.Service.UpdatedAt }</p>
		</div>
	</div>
	<!-- Extras -->
	<div class="mt-4">
		<h1 class="font-medium">Included Add-ons</h1>
		@partials.Divider()
		<div>
			for _, extra := range booking.Extras {
				@partials.Collapsable(partials.CollapsableProps{
					Title:    extra.Title,
					EndText:  utils.FormatCurrency(extra.Price),
					Content:  extra.Description,
					Expanded: true,
				})
			}
		</div>
	</div>
}
