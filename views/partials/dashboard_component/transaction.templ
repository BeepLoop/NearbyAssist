package dashboardcomponent

import (
	"nearbyassist/internal/models"
	"nearbyassist/views/partials"
	"strconv"
)

var loadTransactionChart = templ.NewOnceHandle()

templ Transaction(data models.WeeklyTransactionData) {
	<card class="w-full rounded-sm outline-1 outline-pale-gray hover:shadow-xl hover:outline-primary">
		@templ.JSONScript("transactionData", data)
		<div class="p-2">
			<!-- Title -->
			<span class="mb-2 flex justify-between">
				<p class="text-xs font-medium text-neutral-gray">Transactions</p>
				<p class="text-xs font-medium text-neutral-gray">(last 7 days)</p>
			</span>
			<!-- Count -->
			<div class="flex items-baseline gap-2">
				if data.Difference > 0 {
					@partials.TrendUp()
				} else {
					@partials.TrendDown()
				}
				<p class="text-4xl font-semibold text-neutral-dark">{ strconv.Itoa(data.Total) }</p>
				<p class="text-xs font-semibold text-neutral-gray">total</p>
			</div>
		</div>
		<div class="p-2">
			<!-- Chart -->
			<div id="transactionChart"></div>
			@loadTransactionChart.Once() {
				<script src="/static/script/transactionChart.js"></script>
			}
		</div>
	</card>
}
