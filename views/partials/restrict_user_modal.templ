package partials

type RestrictModalProps struct {
	Title       string
	ButtonLabel string
	ActionURL   string
}

templ RestrictUser(props RestrictModalProps) {
	<div x-data="{restrictModalOpen: false, loading: false}">
		<!-- open button -->
		<button
			type="button"
			class="w-full cursor-pointer rounded-sm bg-danger/25 p-2 text-center font-medium text-danger transition hover:opacity-75"
			x-on:click="restrictModalOpen = true"
		>
			<span class="flex items-center gap-1 text-xs">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
					<path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636"></path>
				</svg>
				<p>{ props.ButtonLabel }</p>
			</span>
		</button>
		<!-- backdrop -->
		<div
			x-cloak
			x-show="restrictModalOpen"
			x-on:keydown.esc.window="restrictModalOpen = false"
			x-on:click.self="restrictModalOpen = false"
			role="dialog"
			aria-modal="true"
			aria-labelledby="defaultModalTitle"
			class="fixed inset-0 z-30 grid place-content-center bg-neutral-gray/50"
		>
			<!-- modal content -->
			<div
				x-show="restrictModalOpen"
				x-transition:enter="transition ease-out duration-200 delay-100 motion-reduce:transition-opacity"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				class="relative rounded-sm bg-white p-2 p-4 outline-1 outline-pale-gray"
			>
				<!-- Spinner -->
				<div
					x-show="loading"
					class="absolute inset-0 grid place-items-center bg-neutral-gray/30 outline-none border-none"
				>
					@Spinner()
				</div>
				<!-- Dialog Header -->
				<div class="flex items-center justify-between">
					<h3 id="defaultModalTitle" class="font-semibold tracking-wide">{ props.Title }</h3>
					<button
						x-on:click="restrictModalOpen = false"
						aria-label="close modal"
						class="cursor-pointer"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" fill="none" stroke-width="1.4" class="h-5 w-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<!-- Dialog Body -->
				<form
					action={ templ.SafeURL(props.ActionURL) }
					method="POST"
					x-on:submit="loading = true"
				>
					<div>
						<input type="hidden" name="redirectRoute" id="redirectRoute"/>
						<script>
                            (function() {
                                function closestSiblingWithId(el, id) {
                                    let sibling = el.previousElementSibling;

                                    while(sibling) {
                                        if (sibling.id === id) {
                                            return sibling;
                                        }

                                        sibling = sibling.previousElementSibling;
                                    }

                                    return null;
                                 }

                                 const script = document.currentScript;
                                 const hiddenInput = closestSiblingWithId(script, "redirectRoute")
                                 if (!hiddenInput) return;

                                 hiddenInput.value = window.location.pathname;
                             })();
                        </script>
					</div>
					<!-- Inputs -->
					<div class="mt-4 grid gap-2">
						<!-- duration -->
						<div>
							<label for="duration" class="font-medium text-neutral-dark">Duration</label>
							@DaysInput(DaysInputProps{
								Id:          "duration",
								Name:        "duration",
								Placeholder: "restriction duration",
							})
						</div>
						<!-- reason -->
						<div>
							<label
								for="reason"
								class="font-medium text-neutral-dark"
							>Reason</label>
							<textarea
								name="reason"
								id="reason"
								rows="6"
								placeholder="reason..."
								autocomplete="off"
								required
								class="mt-1.5 w-full rounded-sm p-2 text-xs text-neutral-dark outline-1 outline-pale-gray"
							></textarea>
						</div>
						<!-- admin password -->
						<div>
							<label for="password" class="font-medium text-neutral-dark">Password</label>
							@Password(PasswordProps{
								Placeholder: "admin password",
								Id:          "password",
								Name:        "password",
							})
						</div>
					</div>
					<!-- Warning message -->
					<div class="mt-4">
						<p class="py-2 text-xs text-danger">
							This action restricts the account for the specified duration.
						</p>
					</div>
					<!-- Dialog Footer -->
					<div class="mt-4 flex justify-end gap-2">
						<button
							x-on:click="restrictModalOpen = false"
							type="button"
							class="cursor-pointer rounded-sm px-4 py-2 font-medium text-neutral-dark hover:bg-neutral-gray/25 hover:opacity-75"
						>Cancel</button>
						<button
							type="submit"
							class="cursor-pointer rounded-sm bg-danger px-4 py-2 text-center font-medium text-white hover:opacity-75"
						>
							<span class="flex items-center gap-1">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
									<path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636"></path>
								</svg>
								<p>{ props.ButtonLabel }</p>
							</span>
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
