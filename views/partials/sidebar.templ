package partials

templ Sidebar() {
	<div class="h-screen flex flex-col outline-1 outline-pale-gray justify-between bg-white">
		<div>
			@logo()
			@navlist()
		</div>
		@user()
	</div>
}

templ logo() {
	<div class="px-4 py-3">
		<div class="text-xl font-bold">
			<span class="">Nearby</span>
			<span class="text-green-700">Assist</span>
		</div>
	</div>
}

templ user() {
	<div
		x-data="{ isOpen: false, openedWithKeyboard: false }"
		class="relative outline-1 outline-pale-gray"
		x-on:keydown.esc.window="isOpen = false, openedWithKeyboard = false"
	>
		<!-- Toggle Button -->
		<button
			type="button"
			x-on:click="isOpen = ! isOpen"
			class="p-2 inline-flex w-full justify-between items-center gap-2 whitespace-nowrap text-sm tracking-wide transition cursor-pointer hover:bg-primary/50 hover:opacity-75"
			aria-haspopup="true"
			x-on:keydown.space.prevent="openedWithKeyboard = true"
			x-on:keydown.enter.prevent="openedWithKeyboard = true"
			x-on:keydown.down.prevent="openedWithKeyboard = true"
			x-bind:class="isOpen || openedWithKeyboard ? 'text-on-surface-strong dark:text-on-surface-dark-strong' : 'text-on-surface dark:text-on-surface-dark'"
			x-bind:aria-expanded="isOpen || openedWithKeyboard"
		>
			<div class="flex gap-1 items-center">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					strokeWidth="1.5"
					stroke="currentColor"
					class="size-6"
				>
					<path strokeLinecap="round" strokeLinejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
				</svg>
				<span>Admin </span>
			</div>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				stroke="currentColor"
				fill="none"
				stroke-width="1"
				class="size-5"
				aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
			</svg>
		</button>
		<!-- Dropdown Menu -->
		<div
			x-cloak
			x-show="isOpen || openedWithKeyboard"
			x-transition
			x-trap="openedWithKeyboard"
			x-on:click.outside="isOpen = false, openedWithKeyboard = false"
			x-on:keydown.down.prevent="$focus.wrap().next()"
			x-on:keydown.up.prevent="$focus.wrap().previous()"
			class="z-50 absolute left-full bottom-2 flex w-fit min-w-48 flex-col overflow-hidden rounded-sm outline-1 outline-pale-gray bg-white shadow-xl"
			role="menu"
		>
			<form action="/admin/logout" method="POST">
				<button
					type="submit"
					class="w-full flex items-center gap-2 px-4 py-2 text-sm text-neutral-dark hover:bg-danger/50"
					role="menuitem"
				>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="red" class="size-4">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"></path>
					</svg>
					Sign-out
				</button>
			</form>
		</div>
	</div>
}

templ navlist() {
	<div class="pl-3">
		<ul class="">
			@navItem("/admin/dashboard", "dashboard") {
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="1.5" stroke="currentColor" class="size-5">
					<path strokeLinecap="round" strokeLinejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z"></path>
					<path strokeLinecap="round" strokeLinejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z"></path>
				</svg>
			}
			@navItem("/admin/map", "map") {
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="1.5" stroke="currentColor" class="size-5">
					<path strokeLinecap="round" strokeLinejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z"></path>
				</svg>
			}
			@navItem("/admin/verification-requests", "identity verification") {
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="1.5" stroke="currentColor" class="size-5">
					<path strokeLinecap="round" strokeLinejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Zm6-10.125a1.875 1.875 0 1 1-3.75 0 1.875 1.875 0 0 1 3.75 0Zm1.294 6.336a6.721 6.721 0 0 1-3.17.789 6.721 6.721 0 0 1-3.168-.789 3.376 3.376 0 0 1 6.338 0Z"></path>
				</svg>
			}
			@navItem("/admin/vendor-applications", "vendor applications") {
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="1.5" stroke="currentColor" class="size-5">
					<path strokeLinecap="round" strokeLinejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
				</svg>
			}
			@navItem("/admin/account-management", "account management") {
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="1.5" stroke="currentColor" class="size-5">
					<path strokeLinecap="round" strokeLinejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"></path>
				</svg>
			}
			@navItem("/admin/complaints", "complaints") {
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="1.5" stroke="currentColor" class="size-5">
					<path strokeLinecap="round" strokeLinejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z"></path>
				</svg>
			}
		</ul>
	</div>
}

templ navItem(path, title string) {
	<a href={ templ.URL(path) } data-path={ path } class="flex gap-3 rounded-l-3xl px-3 py-2 items-center hover:bg-primary hover:opacity-75">
		{ children... }
		<span>{ title }</span>
		<script>
            (() => {
                 let currentScript = document.currentScript;
                 let parent = currentScript.closest("a");
                 const path = parent.getAttribute("data-path");
                 if (location.pathname.includes(path)) {
                     parent.classList.add("active");
                 }
             })()
        </script>
	</a>
}
