package pages

import "nearbyassist/views/layout"

templ PrivacyPolicy() {
	@layout.NoLayout() {
		<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
			<header class="text-center mb-8">
				<h1 class="text-3xl font-bold text-gray-900">Privacy Policy</h1>
				<p class="text-gray-600 mt-2">Effective Date: <span>November 21, 2024</span></p>
			</header>
			<section class="bg-white shadow-md rounded-lg p-6">
				<h2 class="text-2xl font-semibold mb-4">Information We Collect</h2>
				<p>When you log in using Facebook authentication, we collect the following information:</p>
				<ul class="list-disc list-inside ml-4 mt-2">
					<li><strong>Name</strong></li>
					<li><strong>Email address</strong></li>
					<li><strong>Profile picture URL</strong></li>
				</ul>
				<h2 class="text-2xl font-semibold mt-8 mb-4">How We Use Your Information</h2>
				<p>We use your data primarily for the following purposes:</p>
				<ul class="list-disc list-inside ml-4 mt-2">
					<li>To identify you as a user of <strong>NearbyAssist</strong>.</li>
					<li>To manage your account and personalize your experience within the app.</li>
				</ul>
				<h2 class="text-2xl font-semibold mt-8 mb-4">Data Storage and Security</h2>
				<p>Your data is stored securely in our database and is encrypted to protect your privacy. We implement strict security measures to safeguard your information. However, no system is entirely secure, and we cannot guarantee absolute protection.</p>
				<h2 class="text-2xl font-semibold mt-8 mb-4">Data Deletion Request</h2>
				<p>You can request the deletion of your data at any time by contacting us at <a href="mailto:[Insert Email Address]" class="text-blue-500 hover:underline">[Insert Email Address]</a>. To remove your data from Facebook, please follow Facebook's data deletion instructions or visit <a href="[Insert Callback URL]" class="text-blue-500 hover:underline">[Insert Callback URL]</a>.</p>
				<h2 class="text-2xl font-semibold mt-8 mb-4">Updates to This Policy</h2>
				<p>We may revise this Privacy Policy occasionally. Any changes will be communicated through the app or on our website. Please review this policy periodically for updates.</p>
			</section>
		</div>
	}
}
