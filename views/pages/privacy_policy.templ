package pages

import "nearbyassist/views/layout"

templ PrivacyPolicy() {
	@layout.NoLayout() {
		<div class="max-w-3xl mx-auto">
			<h1 class="text-4xl font-bold text-blue-700 mb-4">Example Privacy Policy</h1>
			<p class="text-sm text-gray-600 mb-8">Effective Date: October 27, 2024</p>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">1. Introduction</h2>
				<p class="text-gray-600">
					This Privacy Policy explains how we collect, use, and protect your personal data when you use our app ("Service"). 
					By using the Service, you agree to the terms outlined in this policy.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">2. Information We Collect</h2>
				<ul class="list-disc list-inside text-gray-600">
					<li><strong>Personal Information:</strong> Name, email address, phone number, and payment details.</li>
					<li><strong>Usage Data:</strong> IP address, browser type, and interaction data collected automatically when you use the app.</li>
					<li><strong>Location Data:</strong> If you allow location access, we collect GPS coordinates to improve service matching.</li>
					<li><strong>Chat Messages:</strong> Messages sent between users are stored for service-related purposes.</li>
				</ul>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">3. How We Use Your Information</h2>
				<ul class="list-disc list-inside text-gray-600">
					<li>To provide and manage the Service.</li>
					<li>To process payments and manage transactions.</li>
					<li>To send notifications related to the service or transactions.</li>
					<li>To improve the app experience based on analytics and user feedback.</li>
				</ul>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">4. Sharing Your Information</h2>
				<p class="text-gray-600">We do not sell your personal information. We may share your data with:</p>
				<ul class="list-disc list-inside text-gray-600">
					<li>Service providers to assist with payment processing and customer support.</li>
					<li>Legal authorities if required by law or to protect our rights.</li>
				</ul>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">5. Data Security</h2>
				<p class="text-gray-600">
					We implement industry-standard security measures to protect your data. However, no method of transmission or storage is 100% secure.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">6. Your Rights</h2>
				<ul class="list-disc list-inside text-gray-600">
					<li>You can request access to your personal data.</li>
					<li>You can request corrections or deletion of inaccurate data.</li>
					<li>You can opt out of non-essential data collection by contacting us.</li>
				</ul>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">7. Changes to This Privacy Policy</h2>
				<p class="text-gray-600">
					We may update this policy from time to time. Changes will be posted on this page with an updated effective date.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">8. Contact Us</h2>
				<p class="text-gray-600">If you have any questions about this policy, contact us at:</p>
				<p class="text-gray-600">
					Email: <a href="mailto:support@example.com" class="text-blue-600 hover:underline">support@example.com</a>
					<br/>
					Phone: +1 123-456-7890
				</p>
			</section>
		</div>
	}
}
