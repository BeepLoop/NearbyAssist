package pages

import (
	"fmt"
	"nearbyassist/internal/models"
	"nearbyassist/views/layout"
	"nearbyassist/views/partials"
)

var imageViewer = templ.NewOnceHandle()

templ VendorApplicationDetails(application models.ApplicationModel) {
	@imageViewer.Once() {
		<script src="/static/script/imageViewer.js" defer></script>
	}
	@layout.Layout() {
		@partials.PageBanner("Application Details", "Here are the details of the application")
		<div class="max-w-6xl mx-auto grid grid-cols-[26rem_1fr] gap-4">
			<div>
				<table class="w-full text-left">
					<tbody>
						<tr>
							<th class="py-2 font-medium text-gray-700">Applicant:</th>
							<td class="py-2">{ application.ApplicantName }</td>
						</tr>
						<tr>
							<th class="py-2 font-medium text-gray-700">Expertise:</th>
							<td class="py-2">{ application.Expertise }</td>
						</tr>
						<tr>
							<th class="py-2 font-medium text-gray-700">Status:</th>
							<td class="py-2">
								if application.Status == "pending" {
									<span class="inline-block px-3 py-1 text-sm font-medium bg-yellow-100 text-yellow-700 rounded-full">
										{ string(application.Status) }
									</span>
								} else if application.Status == "approved" {
									<span class="inline-block px-3 py-1 text-sm font-medium bg-green-100 text-green-700 rounded-full">
										{ string(application.Status) }
									</span>
								} else {
									<span class="inline-block px-3 py-1 text-sm font-medium bg-red-100 text-red-700 rounded-full">
										{ string(application.Status) }
									</span>
								}
							</td>
						</tr>
					</tbody>
				</table>
				<!-- Image Selection Buttons -->
				<div class="mt-6 space-y-4" id="image-controls">
					<button
						class="w-full px-4 py-2 bg-green-200 text-green-700 font-medium rounded-lg hover:bg-green-300"
						data-button="front"
						data-image={ application.SupportingDocumentUrl }
					>
						View Front of ID
					</button>
					<button
						class="w-full px-4 py-2 bg-green-200 text-green-700 font-medium rounded-lg hover:bg-green-300"
						data-button="back"
						data-image={ application.PoliceClearanceUrl }
					>
						View Back of ID
					</button>
				</div>
				<!-- Action Buttons -->
				<div class="mt-6 flex gap-4">
					<form
						action={ templ.SafeURL(fmt.Sprintf("/admin/vendor-applications/accept/%s", application.Id)) }
						method="POST"
					>
						<button
							type="submit"
							class="flex-1 px-4 py-2 bg-green-600 text-white font-medium rounded-lg shadow hover:bg-green-700"
						>
							Approve
						</button>
					</form>
					<form
						action={ templ.SafeURL(fmt.Sprintf("/admin/vendor-applications/reject/%s", application.Id)) }
						method="POST"
					>
						<button
							type="submit"
							class="flex-1 px-4 py-2 bg-red-600 text-white font-medium rounded-lg shadow hover:bg-red-700"
						>
							Reject
						</button>
					</form>
				</div>
			</div>
			<!-- Right Side: Image Viewer -->
			<div class="w-full h-full outline outline-1">
				<img
					id="image-viewer"
					src="https://via.placeholder.com/400x300"
					alt="Selected Image"
					class="w-full h-full object-contain bg-gray-200"
				/>
			</div>
		</div>
	}
}
