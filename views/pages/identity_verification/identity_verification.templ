package pages

import (
	"fmt"
	"nearbyassist/internal/models"
	"nearbyassist/views/layout"
	"nearbyassist/views/partials"
)

templ IdentityVerification(requests []models.IdentityVerificationModel) {
	@layout.Layout() {
		@partials.PageBanner("Verification requests", "View and manage identity verification requests")
		@requestsData(requests)
		@partials.Pagination()
	}
}

templ requestsData(requests []models.IdentityVerificationModel) {
	<div class="overflow-hidden w-full overflow-x-auto rounded-sm outline-1 outline-gray-300">
		<table class="w-full text-left text-sm">
			<thead class="text-white text-sm font-semibold bg-primary-greener">
				<tr>
					<th scope="col" class="p-4">Request ID</th>
					<th scope="col" class="p-4">User</th>
					<th scope="col" class="p-4">Applied On</th>
					<th scope="col" class="p-4">Action</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-300">
				if len(requests) < 1 {
					<tr class="">
						<td class="px-6 py-4 text-neutral-dark" align="center" colspan="4" id="emptyTable"></td>
					</tr>
				} else {
					for _, request := range requests {
						<tr class="text-xs">
							<td class="p-4">
								{ request.Id }
							</td>
							<td class="p-4">{ request.Name }</td>
							<td class="p-4">{ request.CreatedAt }</td>
							<td class="p-4">
								<ul>
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/verification-requests/%s", request.Id)) }
										class="whitespace-nowrap w-min rounded-sm text-neutral-gray p-1 font-semibold outline-1 outline-neutral-gray hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-2 active:opacity-100 active:outline-offset-0"
									>
										view request
									</a>
								</ul>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}
