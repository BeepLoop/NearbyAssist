package pages

import (
	"fmt"
	"nearbyassist/internal/dto"
	"nearbyassist/internal/models"
	"nearbyassist/views/layout"
	"nearbyassist/views/partials"
	"strconv"
)

templ ViewReportedUserDetail(user models.AdminModel, data dto.UserReportDetail) {
	@layout.Layout(user) {
		<!-- Actions -->
		<div class="flex justify-between">
			@partials.BackButton()
		</div>
		<div class="mx-auto max-w-3xl">
			<div x-data="{ selectedTab: 'overview' }" class="w-full">
				<!-- tab buttons button -->
				<div
					x-on:keydown.right.prevent="$focus.wrap().next()"
					x-on:keydown.left.prevent="$focus.wrap().previous()"
					class="flex gap-2 overflow-x-auto border-b border-success"
					role="tablist"
					aria-label="tab options"
				>
					<!-- overview button -->
					<button
						x-on:click="selectedTab = 'overview'"
						x-bind:aria-selected="selectedTab === 'overview'"
						x-bind:tabindex="selectedTab === 'overview' ? '0' : '-1'"
						x-bind:class="selectedTab === 'overview' ? 'font-bold text-primary border-b-2 border-primary' : 'text-neutral-gray hover:border-b-2 hover:border-b-primary hover:text-neutral-dark'"
						class="h-min px-4 py-2 text-sm"
						type="button"
						role="tab"
						aria-controls="tabpanelOverview"
					>Overview</button>
					<!-- booking button -->
					if data.Report.Category == "booking_related" {
						<button
							x-on:click="selectedTab = 'booking'"
							x-bind:aria-selected="selectedTab === 'booking'"
							x-bind:tabindex="selectedTab === 'booking' ? '0' : '-1'"
							x-bind:class="selectedTab === 'booking' ? 'font-bold text-primary border-b-2 border-primary' : 'text-neutral-gray hover:border-b-2 hover:border-b-primary hover:text-neutral-dark'"
							class="h-min px-4 py-2 text-sm"
							type="button"
							role="tab"
							aria-controls="tabpanelBooking"
						>Booking</button>
					}
					<!-- reported button -->
					<button
						x-on:click="selectedTab = 'reported'"
						x-bind:aria-selected="selectedTab === 'reported'"
						x-bind:tabindex="selectedTab === 'reported' ? '0' : '-1'"
						x-bind:class="selectedTab === 'reported' ? 'font-bold text-primary border-b-2 border-primary' : 'text-neutral-gray hover:border-b-2 hover:border-b-primary hover:text-neutral-dark'"
						class="h-min px-4 py-2 text-sm"
						type="button"
						role="tab"
						aria-controls="tabpanelReported"
					>Reported</button>
					<!-- reporter button -->
					<button
						x-on:click="selectedTab = 'reporter'"
						x-bind:aria-selected="selectedTab === 'reporter'"
						x-bind:tabindex="selectedTab === 'reporter' ? '0' : '-1'"
						x-bind:class="selectedTab === 'reporter' ? 'font-bold text-primary border-b-2 border-primary' : 'text-neutral-gray hover:border-b-2 hover:border-b-primary hover:text-neutral-dark'"
						class="h-min px-4 py-2 text-sm"
						type="button"
						role="tab"
						aria-controls="tabpanelReporter"
					>Reporter</button>
				</div>
				<!-- tab contents button -->
				<div class="px-2 py-4 text-neutral-dark dark:text-neutral-dark">
					<!-- overview content -->
					<div
						x-cloak
						x-show="selectedTab === 'overview'"
						id="tabpanelOverview"
						role="tabpanel"
						aria-label="overview"
					>
						<div>
							<div class="mt-2 flex gap-2">
								<span class="font-medium text-neutral-dark">Report ID:</span>
								<p class="text-neutral-gray">{ data.Report.Id }</p>
							</div>
							<div class="mt-2 flex gap-2">
								<span class="font-medium text-neutral-dark">Category:</span>
								<p class="text-neutral-gray">{ data.Report.Category }</p>
							</div>
							if data.Report.Category == "booking_related" {
								<div class="mt-2 flex gap-2">
									<span class="font-medium text-neutral-dark">Booking ID:</span>
									<p class="text-neutral-gray">{ data.Report.BookingId }</p>
								</div>
							}
							<div class="mt-2">
								<span class="font-medium text-neutral-dark">Reason:</span>
								<p class="text-neutral-gray">{ data.Report.Reason }</p>
							</div>
							<div class="mt-2">
								<span class="font-medium text-neutral-dark">Detail:</span>
								<p class="text-neutral-gray">{ data.Report.Detail }</p>
							</div>
							<!-- Images -->
							<div class="mt-4">
								<h4 class="font-bold text-neutral-dark">Images</h4>
								<div class="mt-2 grid grid-cols-3 gap-2">
									for _, image := range data.Report.Images {
										@partials.ImageViewer(fmt.Sprintf("/api/v1/resource/%s", image))
									}
								</div>
							</div>
						</div>
					</div>
					<!-- booking content -->
					if data.Report.Category == "booking_related" {
						<div
							x-cloak
							x-show="selectedTab === 'booking'"
							id="tabpanelBooking"
							role="tabpanel"
							aria-label="booking"
						>
							<div>
								@partials.PrintJSON(data)
							</div>
						</div>
					}
					<!-- reported content -->
					<div
						x-cloak
						x-show="selectedTab === 'reported'"
						id="tabpanelReported"
						role="tabpanel"
						aria-label="reported"
					>
						<!-- Information -->
						<div class="mt-4">
							<h1 class="text-xl font-medium">Information</h1>
							<!-- Divider -->
							<div class="border-t-2 border-solid border-t-pale-gray outline-none"></div>
							<div>
								<div class="flex justify-between mt-2">
									<img
										src={ data.Reported.ImageURL }
										alt="User Profile Image"
										class="aspect-square h-44 w-44 outline-1 outline-pale-gray"
									/>
									<div>
										<a
											href={ templ.URL(fmt.Sprintf("/admin/user-management/vendors/%s", data.Reported.Id)) }
											class="bg-primary text-white rounded-sm px-3 py-1.5 cursor-pointer hover:opacity-75"
										>View Profile</a>
									</div>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Name:</span>
									<p class="text-neutral-gray">{ data.Reported.Name }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Email:</span>
									<p class="text-neutral-gray">{ data.Reported.Email }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Address:</span>
									<p class="text-neutral-gray">{ data.Reported.Address }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Phone:</span>
									<p class="text-neutral-gray">{ data.Reported.Phone }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Account Created At:</span>
									<p class="text-neutral-gray">{ data.Reported.CreatedAt }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Account Verified At:</span>
									<p class="text-neutral-gray">{ data.Reported.DateVerified }</p>
								</div>
							</div>
						</div>
						<!-- History -->
						<div class="mt-4">
							<h1 class="text-xl font-medium">History</h1>
							<!-- Divider -->
							<div class="border-t-2 border-solid border-t-pale-gray outline-none"></div>
							<div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Total Bookings:</span>
									<p class="text-neutral-gray">{ strconv.Itoa(data.ReportedUserHistory.Bookings) }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Completed Bookings:</span>
									<p class="text-neutral-gray">{ strconv.Itoa(data.ReportedUserHistory.CompletedBookings) }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Rejected Bookings:</span>
									<p class="text-neutral-gray">{ strconv.Itoa(data.ReportedUserHistory.RejectedBookings) }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Active Bookings:</span>
									<p class="text-neutral-gray">{ strconv.Itoa(data.ReportedUserHistory.ActiveBookings) }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Previous Reports:</span>
									<p class="text-neutral-gray">{ strconv.Itoa(data.ReportedUserHistory.PreviousReports) }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Account Created At:</span>
									<p class="text-neutral-gray">{ data.ReportedUserHistory.AccountCreatedAt }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Account Created At:</span>
									<p class="text-neutral-gray">{ data.ReportedUserHistory.JoinedVendorAt }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Vendor Rating:</span>
									<span class="flex gap-2 text-warning">
										<p class="font-medium">{ data.ReportedUserHistory.Rating }</p>
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
											<path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd"></path>
										</svg>
									</span>
								</div>
							</div>
						</div>
					</div>
					<!-- reporter content -->
					<div
						x-cloak
						x-show="selectedTab === 'reporter'"
						id="tabpanelReporter"
						role="tabpanel"
						aria-label="reporter"
					>
						<!-- Information -->
						<div class="mt-4">
							<h1 class="font-medium text-xl">Information</h1>
							<!-- Divider -->
							<div class="border-t-2 border-solid border-t-pale-gray outline-none"></div>
							<div>
								<div class="flex justify-between mt-2">
									<img
										src={ data.Reporter.ImageURL }
										alt="User Profile Image"
										class="aspect-square h-44 w-44 outline-1 outline-pale-gray"
									/>
									<div>
										<a
											href={ templ.URL(fmt.Sprintf("/admin/user-management/users/%s", data.Reporter.Id)) }
											class="bg-primary text-white rounded-sm px-3 py-1.5 cursor-pointer hover:opacity-75"
										>View Profile</a>
									</div>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Name:</span>
									<p class="text-neutral-gray">{ data.Reporter.Name }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Email:</span>
									<p class="text-neutral-gray">{ data.Reporter.Email }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Address:</span>
									<p class="text-neutral-gray">{ data.Reporter.Address }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Phone:</span>
									<p class="text-neutral-gray">{ data.Reporter.Phone }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Account Created At:</span>
									<p class="text-neutral-gray">{ data.Reporter.CreatedAt }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="font-medium text-neutral-dark">Date Verified:</span>
									<p class="text-neutral-gray">{ data.Reporter.DateVerified }</p>
								</div>
							</div>
						</div>
						<!-- History -->
						<div class="mt-4">
							<h1 class="text-xl font-medium">History</h1>
							<!-- Divider -->
							<div class="border-t-2 border-solid border-t-pale-gray outline-none"></div>
							<div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Reports Filed:</span>
									<p class="text-neutral-gray">{ strconv.Itoa(data.ReporterHistory.ReportsFiled) }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">False Reports:</span>
									<p class="text-neutral-gray">{ strconv.Itoa(data.ReporterHistory.FalseReports) }</p>
								</div>
								<div class="flex gap-2 mt-2">
									<span class="text-neutral-dark font-medium">Cancelled Bookings:</span>
									<p class="text-neutral-gray">{ strconv.Itoa(data.ReporterHistory.CancelledBookings) }</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}

templ addressReport(data models.UserReportModel) {
	<div x-data="{offCanvasOpen: false}">
		<!-- offCanvas Button -->
		<button
			x-on:click="offCanvasOpen = !offCanvasOpen"
			type="button"
			class="cursor-pointer rounded-sm bg-primary p-2 text-sm font-medium text-white hover:opacity-75"
		>Address</button>
		<!-- offCanvas Backdrop -->
		<div
			x-cloak
			x-show="offCanvasOpen"
			x-on:keydown.esc.window="offCanvasOpen = false"
			x-on:click.self="offCanvasOpen = false"
			role="dialog"
			class="fixed inset-0 bg-neutral-gray/50"
		>
			<!-- offCanvas Sidebar -->
			<div
				x-cloak
				x-show="offCanvasOpen"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="translate-x-full"
				x-transition:enter-end="translate-x-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="translate-x-0"
				x-transition:leave-end="translate-x-full"
				role="document"
				class="fixed top-0 right-0 flex h-full w-md flex-col bg-white p-4 outline-1 outline-pale-gray"
			>
				<!-- Header -->
				<div class="flex justify-end">
					<button
						x-on:click="offCanvasOpen = false"
						type="button"
						class="flex cursor-pointer items-center rounded-sm px-3 py-1.5 hover:bg-neutral-gray/25 hover:opacity-75"
					>
						<svg
							class="hi-solid hi-x -mx-1 inline-block size-4"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								fill-rule="evenodd"
								d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
								clip-rule="evenodd"
							></path>
						</svg>
					</button>
				</div>
				<!-- Content -->
				<div class="mt-4">
					<form
						action="/admin/complaints/users/close"
						method="POST"
					>
						<input
							type="text"
							hidden
							name="reportId"
							value={ data.Id }
						/>
						<div class="mt-2">
							<label for="title" class="font-medium">Title</label>
							<input
								type="text"
								name="title"
								id="title"
								placeholder="title"
								class="mt-1.5 w-full rounded-sm border border-neutral-gray-lighter p-2 focus:border-primary focus:outline-none"
							/>
						</div>
						<div class="mt-2">
							<label for="detail" class="font-medium">Detail</label>
							<textarea
								name="detail"
								id="detail"
								rows="6"
								placeholder="more details..."
								autocomplete="off"
								class="mt-1.5 w-full rounded-sm border border-neutral-gray-lighter p-2 text-sm text-neutral-dark focus:border-primary focus:outline-none"
							></textarea>
						</div>
						<div class="mt-4 flex justify-end">
							<button
								type="submit"
								class="cursor-pointer rounded-sm bg-primary px-3 py-1.5 font-medium text-white hover:opacity-75"
							>Okay</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
}
