package pages

import (
	"fmt"
	"nearbyassist/internal/models"
	"nearbyassist/internal/utils"
	"nearbyassist/views/layout"
	"nearbyassist/views/partials"
)

templ VendorAccountDetail(data models.UserAccountPageData, flash string) {
	@layout.Layout() {
		<!-- toasy component -->
		@templ.JSONScript("flash", flash)
		@partials.ToastNotification()
		<!-- back button -->
		@partials.BackButton()
		<!-- main content -->
		<div class="max-w-4xl mx-auto">
			<!-- user profile -->
			<div class="flex justify-between">
				<div class="flex gap-4">
					<img
						src={ data.ProfileURL }
						alt="profile"
						class="w-44 h-44 aspect-square outline-1 outline-pale-gray"
					/>
					<div class="grid gap-2">
						<!-- name & email -->
						<div>
							<h1 class="text-xl font-medium text-neutral-dark">{ data.Name }</h1>
							<h2 class="text-neutral-gray">{ data.Email }</h2>
						</div>
						<!-- id & created at -->
						<div>
							<span class="flex gap-2">
								<p class="font-medium text-neutral-dark">User ID: </p>
								<p class="text-neutral-gray">{ data.Id }</p>
							</span>
							<span class="flex gap-2">
								<p class="font-medium text-neutral-dark">User Since: </p>
								<p class="text-neutral-gray">{ data.CreatedAt }</p>
							</span>
						</div>
						<!-- expertise -->
						<div class="mt-3">
							<p class="font-medium text-xs">Expertise</p>
							<div class="mt-2 flex gap-2">
								for _, expertise := range data.Expertise {
									@partials.DefaultBadgeSuccess(expertise)
								}
							</div>
						</div>
					</div>
				</div>
				<div class="flex gap-2">
					@actions(data)
				</div>
			</div>
			<!-- stats -->
			<div class="mt-8 grid grid-cols-4 gap-4">
				<div class="outline-1 outline-pale-gray rounded-sm p-2">
					<!-- Sent Requests -->
					if data.Stat.Sent.CurrentMonth >= data.Stat.Sent.LastMonth {
						@partials.Increasing("Sent Requests", data.Stat.Sent.CurrentMonth, utils.PercentageIncrease(data.Stat.Sent.CurrentMonth, data.Stat.Sent.LastMonth))
					} else {
						@partials.Decreasing("Sent Requests", data.Stat.Sent.CurrentMonth, utils.PercentageDecrease(data.Stat.Sent.CurrentMonth, data.Stat.Sent.LastMonth))
					}
				</div>
				<div class="outline-1 outline-pale-gray rounded-sm p-2">
					<!-- Received Requests -->
					if data.Stat.Received.CurrentMonth >= data.Stat.Received.LastMonth {
						@partials.Increasing("Received Requests", data.Stat.Received.CurrentMonth, utils.PercentageIncrease(data.Stat.Received.CurrentMonth, data.Stat.Received.LastMonth))
					} else {
						@partials.Decreasing("Received Requests", data.Stat.Received.CurrentMonth, utils.PercentageDecrease(data.Stat.Received.CurrentMonth, data.Stat.Received.LastMonth))
					}
				</div>
			</div>
			<!-- services -->
			@userServices(data.Services)
		</div>
	}
}

templ userServices(services []*models.ServiceModel) {
	<div class="mt-8">
		<h2 class="mb-2 font-medium">Services</h2>
		<div class="overflow-hidden w-full overflow-x-auto rounded-sm outline-1 outline-gray-300">
			<table class="w-full text-left text-sm">
				<thead class="text-white text-sm font-semibold bg-primary-greener">
					<tr>
						<th scope="col" class="p-4 text-xs">Title</th>
						<th scope="col" class="p-4 text-xs">Added on</th>
						<th scope="col" class="p-4 text-xs">Action</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-300">
					if len(services) < 1 {
						<tr class="">
							<td class="px-6 py-4 text-neutral-dark text-xs" align="center" colspan="3" id="emptyTable">No Service Offered</td>
						</tr>
					} else {
						for _, service := range services {
							<tr class="relative outline-1 outline-pale-gray text-neutral-dark text-xs">
								<td class="px-6 py-4">{ service.Title }</td>
								<td class="px-6 py-4">added on { utils.FormatDate(service.CreatedAt) }</td>
								<td class="px-6 py-4">
									@viewService(service)
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ viewService(service *models.ServiceModel) {
	<div x-data="{serviceDetailOpen: false}">
		<!-- offCanvas Button -->
		<button
			type="button"
			class="whitespace-nowrap w-min rounded-sm text-neutral-gray p-1 font-semibold outline-1 outline-neutral-gray hover:opacity-75 cursor-pointer"
			x-on:click="serviceDetailOpen = true"
		>
			<span class="flex gap-1 items-center">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
				</svg>
				<p>View Detail</p>
			</span>
		</button>
		<!-- offCanvas Backdrop -->
		<div
			x-cloak
			x-show="serviceDetailOpen"
			x-on:keydown.esc.window="serviceDetailOpen = false"
			x-on:click.self="serviceDetailOpen = false"
			role="dialog"
			class="fixed inset-0 z-90 bg-neutral-gray/50"
		>
			<!-- offCanvas Sidebar -->
			<div
				x-cloak
				x-show="serviceDetailOpen"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="translate-x-full"
				x-transition:enter-end="translate-x-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="translate-x-0"
				x-transition:leave-end="translate-x-full"
				role="document"
				class="fixed top-0 right-0 w-md h-full px-4 pt-4 pb-6 bg-white flex flex-col outline-1 outline-pale-gray overflow-y-scroll"
			>
				<!-- Header -->
				<div class="flex justify-end">
					<button
						x-on:click="serviceDetailOpen = false"
						type="button"
						class="flex items-center rounded-sm px-3 py-1.5 cursor-pointer hover:bg-neutral-gray/25 hover:opacity-75"
					>
						<svg
							class="hi-solid hi-x -mx-1 inline-block size-4"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								fill-rule="evenodd"
								d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
								clip-rule="evenodd"
							></path>
						</svg>
					</button>
				</div>
				<!-- Content -->
				<div class="mt-4">
					@carousel(service.Images)
					<div class="mt-2 text-neutral-gray">
						<!-- Detail -->
						<div class="grid gap-1 mt-4">
							<h3 class="font-medium text-md">{ service.Title }</h3>
							<p class="text-sm text-neutral-gray">{ service.Description }</p>
							<h4 class="font-medium text-xl">₱ { service.Rate }</h4>
						</div>
						<div class="mt-4">
							<!-- Note -->
							<div class="px-1 py-2 rounded-sm bg-good/25 flex gap-2 text-neutral-gray text-xs mt-2">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
									<path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"></path>
								</svg>
								<p>You can click on the tag to perform a quick map search </p>
							</div>
							<!-- Tags -->
							<div class="flex gap-2 flex-wrap my-2">
								for _, tag := range service.TagsAsString {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/map?query=%s", tag)) }
										class="mt-2"
									>
										@partials.DefaultBadgeSuccess(tag)
									</a>
								}
							</div>
						</div>
						<!-- Extras -->
						<div class="mt-4">
							<h3 class="font-medium text-xl text-md mb-2">Extras</h3>
							for _, extra := range service.Extras {
								<div class="flex justify-between text-sm mt-1.5">
									<p>{ extra.Title }</p>
									<h4 class="font-medium">₱ { utils.FloatToString(extra.Price) }</h4>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ carousel(images []*models.ServicePhotoModel) {
	<div class="relative w-full overflow-hidden outline-1 outline-pale-gray">
		<!-- previous button -->
		<button
			type="button"
			id="prevBtn"
			class="absolute left-5 top-1/2 z-20 flex rounded-full -translate-y-1/2 items-center justify-center bg-surface/40 p-2 text-on-surface transition cursor-pointer"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="3" class="size-5 md:size-6 pr-0.5" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"></path>
			</svg>
		</button>
		<!-- next button -->
		<button
			type="button"
			id="nextBtn"
			class="absolute right-5 top-1/2 z-20 flex rounded-full -translate-y-1/2 items-center justify-center bg-surface/40 p-2 text-on-surface transition cursor-pointer"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="3" class="size-5 md:size-6 pl-0.5" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
			</svg>
		</button>
		<!-- carousel -->
		<div class="relative min-h-[50svh] w-full bg-neutral-gray/50" id="carousel"></div>
		@templ.JSONScript("images", images)
		<script>
            (function() {
                function closestSiblingWithId(el, id) {
                    let sibling = el.previousElementSibling;

                    while(sibling) {
                        if (sibling.id === id) {
                            return sibling;
                        }

                        sibling = sibling.previousElementSibling;
                    }

                    return null;
                }

                function createImageElement(imageSrc) {
                    const classes = [
                        "absolute",
                        "w-full",
                        "h-full",
                        "inset-0",
                        "object-cover",
                        "text-neutral-dark",
                    ];
                    const img = document.createElement("img");
                    classes.forEach(e => img.classList.add(e));
                    img.src = `/api/v1/resource/${imageSrc}`;
                    return img;
                }

                const script = document.currentScript;
                const images = JSON.parse(script.previousElementSibling.textContent);
                const nextBtn = closestSiblingWithId(script, "nextBtn");
                const prevBtn = closestSiblingWithId(script, "prevBtn");
                const carousel = closestSiblingWithId(script, "carousel");
                let currImageIndex = 0;

                if (nextBtn) {
                    nextBtn.addEventListener("click", () => {
                        if (!images.length) return;

                        if (currImageIndex >= images.length - 1) {
                            currImageIndex = 0;
                        } else {
                            currImageIndex++;
                        }

                        if (images.length === 0) return;
                        const img = createImageElement(images[currImageIndex].url);
                        carousel.innerHTML = "";
                        carousel.append(img);
                    });
                }

                if (prevBtn) {
                    prevBtn.addEventListener("click", () => {
                        if (!images.length) return;

                        if (currImageIndex <= 0) {
                            currImageIndex = images.length - 1;
                        } else {
                            currImageIndex--;
                        }

                        if (images.length === 0) return;
                        const img = createImageElement(images[currImageIndex].url);
                        carousel.innerHTML = "";
                        carousel.append(img);
                    });
                }

                if (images.length === 0) return;
                const img = createImageElement(images[currImageIndex].url);
                carousel.innerHTML = "";
                carousel.append(img);
             })();
        </script>
	</div>
}
