package pages

import "nearbyassist/views/layout"

templ TermsAndConditions() {
	@layout.NoLayout() {
		<div class="max-w-3xl mx-auto">
			<h1 class="text-4xl font-bold text-blue-700 mb-4">Example Terms and Conditions</h1>
			<p class="text-sm text-gray-600 mb-8">Effective Date: October 27, 2024</p>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">1. Acceptance of Terms</h2>
				<p class="text-gray-600">
					By accessing or using our app ("Service"), you agree to be bound by these Terms and Conditions. If you do not agree to these terms, please do not use the Service.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">2. User Accounts</h2>
				<ul class="list-disc list-inside text-gray-600">
					<li>You must provide accurate and complete information when creating an account.</li>
					<li>You are responsible for maintaining the confidentiality of your account credentials.</li>
					<li>We reserve the right to suspend or terminate accounts that violate these terms.</li>
				</ul>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">3. User Conduct</h2>
				<p class="text-gray-600">By using the Service, you agree not to:</p>
				<ul class="list-disc list-inside text-gray-600">
					<li>Engage in any unlawful or abusive behavior.</li>
					<li>Post content that is offensive, defamatory, or violates intellectual property rights.</li>
					<li>Interfere with the proper functioning of the Service.</li>
				</ul>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">4. Transactions and Payments</h2>
				<p class="text-gray-600">
					Transactions between service providers and clients are the sole responsibility of the involved parties. We are not liable for disputes arising from these transactions.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">5. Limitation of Liability</h2>
				<p class="text-gray-600">
					We are not liable for any damages resulting from the use or inability to use the Service, including lost profits or data. Your use of the Service is at your own risk.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">6. Intellectual Property</h2>
				<p class="text-gray-600">
					All content, trademarks, and logos displayed on the Service are our intellectual property or that of third parties. You may not use, reproduce, or distribute any content without permission.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">7. Modifications to the Terms</h2>
				<p class="text-gray-600">
					We reserve the right to update or modify these Terms and Conditions at any time. We will notify users of significant changes, and continued use of the Service constitutes acceptance of the new terms.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">8. Termination</h2>
				<p class="text-gray-600">
					We reserve the right to terminate or suspend your account if you violate these terms. Upon termination, your access to the Service will be revoked without prior notice.
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">9. Governing Law</h2>
				<p class="text-gray-600">
					These Terms and Conditions are governed by the laws of [Your Country/State]. Any disputes will be resolved exclusively in the courts of [Your Country/State].
				</p>
			</section>
			<section class="mb-8">
				<h2 class="text-2xl font-semibold text-gray-700 mb-2">10. Contact Us</h2>
				<p class="text-gray-600">
					If you have any questions or concerns about these terms, contact us at:
				</p>
				<p class="text-gray-600">
					Email: <a href="mailto:support@example.com" class="text-blue-600 hover:underline">support@example.com</a>
					<br/>
					Phone: +1 123-456-7890
				</p>
			</section>
		</div>
	}
}
