package pages

import "nearbyassist/views/layout"

templ TermsAndConditions() {
	@layout.BasicLayout() {
		<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
			<header class="text-center mb-8">
				<h1 class="text-3xl font-bold text-gray-900">Terms and Conditions</h1>
				<p class="text-gray-600 mt-2">Effective Date: <span>November 21, 2024</span></p>
			</header>
			<section class="bg-white shadow-md rounded-lg p-6">
				<h2 class="text-2xl font-semibold mb-4">Use of the App</h2>
				<ul class="list-disc list-inside ml-4">
					<li>You must be at least 13 years old to use <strong>NearbyAssist</strong>.</li>
					<li>You are responsible for the security of your login credentials and all activities under your account.</li>
				</ul>
				<h2 class="text-2xl font-semibold mt-8 mb-4">Intellectual Property</h2>
				<p>All content and materials within the app, including logos, graphics, and design, are owned by <strong>NearbyAssist</strong>. Unauthorized use is strictly prohibited.</p>
				<h2 class="text-2xl font-semibold mt-8 mb-4">Prohibited Activities</h2>
				<p>You agree not to:</p>
				<ul class="list-disc list-inside ml-4 mt-2">
					<li>Use the app for illegal activities.</li>
					<li>Disrupt or interfere with the app’s functionality or security.</li>
					<li>Share inappropriate or unlawful content within the app.</li>
				</ul>
				<h2 class="text-2xl font-semibold mt-8 mb-4">Limitation of Liability</h2>
				<p><strong>NearbyAssist</strong> is not liable for any damages resulting from the use of the app. Use of the app is at your own risk.</p>
				<h2 class="text-2xl font-semibold mt-8 mb-4">Termination</h2>
				<p>We reserve the right to suspend or terminate your account if you violate these terms or engage in prohibited activities.</p>
				<h2 class="text-2xl font-semibold mt-8 mb-4">Governing Law</h2>
				<p>These Terms and Conditions are governed by the laws of <span>Philippines</span>.</p>
				<h2 class="text-2xl font-semibold mt-8 mb-4">Updates to These Terms</h2>
				<p>We may revise these Terms and Conditions at any time. Continued use of the app constitutes acceptance of any updated terms.</p>
			</section>
		</div>
	}
}
