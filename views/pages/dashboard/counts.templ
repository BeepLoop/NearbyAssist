package pages

import (
	"nearbyassist/internal/dto"
	"strconv"
)

templ counts(data dto.Dashboard) {
	<div class="grid grid-cols-12 gap-4">
		<!-- Users -->
		<div class="outline-1 outline-pale-gray rounded-sm col-span-2 p-2 hover:outline-primary">
			<a href="/admin/user-management/users">
				<card class="flex gap-4">
					<!-- Icon -->
					<div class="flex justify-center items-center text-good">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
							<path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="text-center">
						<!-- Count -->
						<div class="text-4xl text-neutral-dark font-semibold">
							<h2>{ strconv.Itoa(data.Users.Total) }</h2>
						</div>
						<!-- Label -->
						<div class="text-neutral-dark font-medium text-xs">
							<h3>Total Users</h3>
						</div>
					</div>
				</card>
			</a>
		</div>
		<!-- Vendors -->
		<div class="outline-1 outline-pale-gray rounded-sm col-span-2 p-2 hover:outline-primary">
			<a href="/admin/user-management/vendors">
				<card class="flex gap-4">
					<!-- Icon -->
					<div class="flex justify-center items-center text-primary">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
							<path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="text-center">
						<!-- Count -->
						<div class="text-4xl text-neutral-dark font-semibold">
							<h2>{ strconv.Itoa(data.Users.Vendor) }</h2>
						</div>
						<!-- Label -->
						<div class="text-neutral-dark font-medium text-xs">
							<h3>Total Vendors</h3>
						</div>
					</div>
				</card>
			</a>
		</div>
		<!-- Applications -->
		<div class="outline-1 outline-pale-gray rounded-sm col-span-2 p-2 hover:outline-primary">
			<a href="/admin/vendor-applications">
				<card class="flex gap-4">
					<!-- Icon -->
					<div class="flex justify-center items-center text-warning">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
							<path fill-rule="evenodd" d="M7.502 6h7.128A3.375 3.375 0 0 1 18 9.375v9.375a3 3 0 0 0 3-3V6.108c0-1.505-1.125-2.811-2.664-2.94a48.972 48.972 0 0 0-.673-.05A3 3 0 0 0 15 1.5h-1.5a3 3 0 0 0-2.663 1.618c-.225.015-.45.032-.673.05C8.662 3.295 7.554 4.542 7.502 6ZM13.5 3A1.5 1.5 0 0 0 12 4.5h4.5A1.5 1.5 0 0 0 15 3h-1.5Z" clip-rule="evenodd"></path>
							<path fill-rule="evenodd" d="M3 9.375C3 8.339 3.84 7.5 4.875 7.5h9.75c1.036 0 1.875.84 1.875 1.875v11.25c0 1.035-.84 1.875-1.875 1.875h-9.75A1.875 1.875 0 0 1 3 20.625V9.375ZM6 12a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H6.75a.75.75 0 0 1-.75-.75V12Zm2.25 0a.75.75 0 0 1 .75-.75h3.75a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75ZM6 15a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H6.75a.75.75 0 0 1-.75-.75V15Zm2.25 0a.75.75 0 0 1 .75-.75h3.75a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75ZM6 18a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H6.75a.75.75 0 0 1-.75-.75V18Zm2.25 0a.75.75 0 0 1 .75-.75h3.75a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="text-center">
						<!-- Count -->
						<div class="text-4xl text-neutral-dark font-semibold">
							<h2>{ strconv.Itoa(data.Application.Pending) }</h2>
						</div>
						<!-- Label -->
						<div class="text-neutral-dark font-medium text-xs">
							<h3>Applications</h3>
						</div>
					</div>
				</card>
			</a>
		</div>
		<!-- Services -->
		<div class="outline-1 outline-pale-gray rounded-sm col-span-2 p-2 hover:outline-primary">
			<a href="#">
				<card class="flex gap-4">
					<!-- Icon -->
					<div class="flex justify-center items-center text-warning">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
							<path d="M3.375 3C2.339 3 1.5 3.84 1.5 4.875v.75c0 1.036.84 1.875 1.875 1.875h17.25c1.035 0 1.875-.84 1.875-1.875v-.75C22.5 3.839 21.66 3 20.625 3H3.375Z"></path>
							<path fill-rule="evenodd" d="m3.087 9 .54 9.176A3 3 0 0 0 6.62 21h10.757a3 3 0 0 0 2.995-2.824L20.913 9H3.087Zm6.163 3.75A.75.75 0 0 1 10 12h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="text-center">
						<!-- Count -->
						<div class="text-4xl text-neutral-dark font-semibold">
							<h2>{ strconv.Itoa(data.Services.Active) }</h2>
						</div>
						<!-- Label -->
						<div class="text-neutral-dark font-medium text-xs">
							<h3>Active Services</h3>
						</div>
					</div>
				</card>
			</a>
		</div>
		<!-- Restricted -->
		<div class="outline-1 outline-pale-gray rounded-sm col-span-2 p-2 hover:outline-primary">
			<a href="#">
				<card class="flex gap-4">
					<!-- Icon -->
					<div class="flex justify-center items-center text-warning">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
							<path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="text-center">
						<!-- Count -->
						<div class="text-4xl text-neutral-dark font-semibold">
							<h2>{ strconv.Itoa(data.Users.Restricted) }</h2>
						</div>
						<!-- Label -->
						<div class="text-neutral-dark font-medium text-xs">
							<h3>Restricted Users</h3>
						</div>
					</div>
				</card>
			</a>
		</div>
		<!-- Reports -->
		<div class="outline-1 outline-pale-gray rounded-sm col-span-2 p-2 hover:outline-primary">
			<a href="/admin/complaints/users">
				<card class="flex gap-4">
					<!-- Icon -->
					<div class="flex justify-center items-center text-danger">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
							<path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="text-center">
						<!-- Count -->
						<div class="text-4xl text-neutral-dark font-semibold">
							<h2>{ strconv.Itoa(data.Report.Pending) }</h2>
						</div>
						<!-- Label -->
						<div class="text-neutral-dark font-medium text-xs">
							<h3>Reports</h3>
						</div>
					</div>
				</card>
			</a>
		</div>
	</div>
}
