package pages

import (
	"nearbyassist/internal/response"
	"nearbyassist/views/layout"
	"nearbyassist/views/partials"
	dashboardcomponent "nearbyassist/views/partials/dashboard_component"
	"strconv"
)

templ Dashboard(data response.Analytics) {
	@layout.Layout() {
		@partials.PageBanner("Overview", "Monitor your activities")
		@dashboardData(data)
	}
}

templ dashboardData(data response.Analytics) {
	<div class="grid gap-4">
		<section class="grid grid-cols-4 gap-4">
			@dashboardAnalyticComponent("Total Users", data.User) {
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-6 fill-red-600">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"></path>
				</svg>
			}
			@dashboardAnalyticComponent("Verified Users", data.VerifiedUser) {
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-6 fill-blue-600">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
				</svg>
			}
			@dashboardAnalyticComponent("Expert Users", data.Vendor) {
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-6 fill-green-600">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"></path>
				</svg>
			}
			@dashboardAnalyticComponent("Bug reports", data.Complaint) {
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-6 fill-yellow-600">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"></path>
				</svg>
			}
		</section>
		<section class="grid grid-cols-2 gap-4">
			@dashboardcomponent.BugReport(data.BugReportData)
		</section>
	</div>
}

templ dashboardAnalyticComponent(title string, amount int) {
	<div class="outline-1 outline-pale-gray p-2 rounded-sm hover:shadow-xl">
		<div>
			{ children... }
		</div>
		<div class="mt-4">
			<p class="mb-2 font-medium text-sm text-neutral-gray">{ title }</p>
			<p class="font-semibold text-3xl text-neutral-dark">{ strconv.Itoa(amount) } </p>
		</div>
	</div>
}
