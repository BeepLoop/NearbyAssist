package pages

import (
	"nearbyassist/internal/models"
	"nearbyassist/views/layout"
	"nearbyassist/views/partials"
	dashboardcomponent "nearbyassist/views/partials/dashboard_component"
	"strconv"
)

templ Dashboard(data models.DashboardModel) {
	@layout.Layout() {
		@partials.PageBanner("Overview", "Monitor your activities")
		@dashboardData(data)
	}
}

templ dashboardData(data models.DashboardModel) {
	<section class="grid gap-4">
		<div class="grid gap-4 grid-cols-12">
			<div class="col-span-3 grid">
				<a href="/admin/verification-requests" class="grid">
					<card class="w-full outline-1 outline-pale-gray rounded-sm hover:shadow-xl">
						<!-- Title -->
						<span class="flex justify-between p-2">
							<p class="text-xs text-neutral-gray font-medium">Verification requests</p>
						</span>
						<!-- Count -->
						<div class="flex items-baseline gap-2 p-2">
							<p class="font-semibold text-4xl text-neutral-dark">{ strconv.Itoa(data.RequestData.IdentityVerification.Total) }</p>
							<p class="font-semibold text-xs text-neutral-gray">total</p>
						</div>
					</card>
				</a>
			</div>
			<div class="col-span-3 grid">
				<a href="/admin/vendor-applications" class="grid">
					<card class="w-full outline-1 outline-pale-gray rounded-sm hover:shadow-xl">
						<!-- Title -->
						<span class="flex justify-between p-2">
							<p class="text-xs text-neutral-gray font-medium">Vendor applications</p>
						</span>
						<!-- Count -->
						<div class="flex items-baseline gap-2 p-2">
							<p class="font-semibold text-4xl text-neutral-dark">{ strconv.Itoa(data.RequestData.VendorApplication.Total) }</p>
							<p class="font-semibold text-xs text-neutral-gray">total</p>
						</div>
					</card>
				</a>
			</div>
			<div class="col-span-3 grid">
				<a href="/admin/complaints/bugs" class="grid">
					@dashboardcomponent.BugReport(data.ReportData.WeeklyBugReport)
				</a>
			</div>
			<div class="col-span-3 grid">
				<a href="/admin/complaints/users" class="grid">
					@dashboardcomponent.VendorReport(data.ReportData.WeeklyVendorReport)
				</a>
			</div>
		</div>
		<div class="grid grid-cols-12 gap-4">
			<div class="col-span-4 grid">
				@dashboardcomponent.UserData(data.UserData)
			</div>
			<div class="col-span-8 grid">
				@dashboardcomponent.Transaction(data.TransactionData)
			</div>
		</div>
	</section>
}
