package pages

import (
	"nearbyassist/views/layout"
	"nearbyassist/views/partials"
	"strconv"
)

type Marker struct {
	Lat float64 `json:"lat"`
	Lon float64 `json:"lon"`
}

type MapPageData struct {
	Markers []Marker
	Tags    []string
}

templ Map(data MapPageData) {
	@layout.Layout() {
		<div class="pb-4">
			@partials.PageBanner("Map", "")
			<div class="flex gap-4">
				<div class="">
					@searchBar(data.Tags)
					<span class="text-sm text-neutral-dark font-medium">
						Result: { strconv.Itoa(len(data.Markers)) }
					</span>
				</div>
				<div class="flex-1">
					@mapComponent(data.Markers)
				</div>
			</div>
		</div>
	}
}

templ searchBar(tags []string) {
	<div>
		<div class="relative flex justify-end my-3">
			@templ.JSONScript("tags", tags)
			<form
				action="/admin/map"
				class="flex gap-2"
			>
				<input
					type="input"
					id="searchInput"
					name="query"
					autocomplete="off"
					class="p-2 rounded-sm text-sm outline-1 outline-pale-gray"
					placeholder="service"
					autofocus
				/>
				<button
					type="submit"
					class="p-2 rounded-md bg-primary hover:opacity-75 text-sm text-white"
				>Search</button>
				<script>
                    (function() {
                        const searchInput = document.getElementById("searchInput");
                        const params = new URLSearchParams(location.search);
                        if (params.has("query")) {
                            searchInput.value = params.get("query");
                        }
                     })();
                </script>
			</form>
			<div id="resultBox" class="absolute top-full left-0 right-0 bg-white shadow-xl"></div>
		</div>
		<script>
            const tags = JSON.parse(document.getElementById("tags").textContent);
            const inputBox = document.getElementById("searchInput");
            const resultBox = document.getElementById("resultBox");

            inputBox.onkeyup = () => {
                let suggestions = [];
                const input = inputBox.value;

                if (input.length) {
                    suggestions = tags.filter((tag) => {
                        return tag.toLowerCase().includes(input.toLowerCase());
                    });
                }

                displaySuggestions(suggestions);
            }

            function displaySuggestions(suggestions) {
                resultBox.innerHTML = "";

                const contents = suggestions.map((suggestion) => {
                    const classes = [
                        "bg-white",
                        "p-2",
                        "text-neutral-dark",
                        "text-sm",
                        "cursor-pointer",
                        "hover:bg-neutral-200",
                    ];

                    const div = document.createElement("div");
                    div.innerText = suggestion;
                    div.setAttribute("onclick", `selectSuggestion('${suggestion}')`);

                    classes.forEach((classname) => {
                        div.classList.add(classname);
                    });

                    return div;
                });

                const wrapper = document.createElement("div");
                wrapper.classList.add("outline-1");
                wrapper.classList.add("outline-pale-gray");
                wrapper.classList.add("rounded-sm");
                for (const content of contents) {
                    wrapper.appendChild(content);
                }
                resultBox.appendChild(wrapper);
            }

            function selectSuggestion(suggestion) {
                inputBox.value = suggestion;
                resultBox.innerHTML = "";
            }
        </script>
	</div>
}

var openLayers = templ.NewOnceHandle()

templ mapComponent(markers []Marker) {
	@openLayers.Once() {
		<script src="/static/script/OpenLayers.js"></script>
	}
	<div id="map" class="h-[75vh] outline-1 outline-gray-300"></div>
	@templ.JSONScript("markers", markers)
	<script>
        map = new OpenLayers.Map("map");
        let mapnik = new OpenLayers.Layer.OSM();
        let fromProjection = new OpenLayers.Projection("EPSG:4326");   // Transform from WGS 1984
        let toProjection = new OpenLayers.Projection("EPSG:900913"); // to Spherical Mercator Projection
        let position = new OpenLayers.LonLat(125.80942522476553, 7.447220876004841).transform(fromProjection, toProjection);
        let zoom = 13;

        let markers = new OpenLayers.Layer.Markers("Markers");

        try{
            const markersJson = document.getElementById("markers").textContent;
            const coordinates = JSON.parse(markersJson);

            for (const coordinate of coordinates) {
                const marker = new OpenLayers.LonLat(coordinate.lon, coordinate.lat).transform(fromProjection, toProjection);
                markers.addMarker(new OpenLayers.Marker(marker));
            }
        } catch (e) {
            console.error("Error parsing markers", e);
        }

        map.addLayer(mapnik);
        map.addLayer(markers);
        map.setCenter(position, zoom);

    </script>
}
