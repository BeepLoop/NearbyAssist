package settings

import (
	"nearbyassist/internal/models"
	"nearbyassist/views/layout"
	"nearbyassist/views/partials"
)

templ Settings(admin models.AdminModel, flash string, searchBehavior string) {
	@layout.Layout(admin) {
		<!-- toast -->
		@templ.JSONScript("flash", flash)
		@partials.ToastNotification()
		<!-- banner -->
		@partials.PageBanner("Settings", "")
		<!-- main content -->
		<div class="mx-auto max-w-3xl">
			@settingItem(settingItemProps{
				Title:       "Server Sent Events (SSE) data reset",
				ButtonLabel: "Reset",
				ActionURL:   "/admin/settings/resetSSE",
			})
			@settingItem(settingItemProps{
				Title:       "Send reminder for bookings scheduled tomorrow",
				ButtonLabel: "Notify",
				ActionURL:   "/admin/settings/remind",
			})
			<div class="flex items-center justify-between border-b border-pale-gray p-2">
				<p class="text-xs font-medium text-neutral-dark">Search behavior</p>
				<form class="flex items-center gap-2" action="/admin/settings/searchBehavior" method="POST">
					<input
						list="search_behaviors"
						name="behavior"
						value={ searchBehavior }
						required
						autocomplete="off"
						class="rounded-sm p-1 text-xs outline-1 outline-pale-gray focus:outline-primary"
					/>
					<datalist id="search_behaviors">
						<option value="exact_match"></option>
						<option value="fuzzy_match"></option>
					</datalist>
					<button
						type="submit"
						class="cursor-pointer rounded-sm bg-primary px-2 py-1.5 text-xs font-medium text-white hover:opacity-75"
					>save</button>
				</form>
			</div>
		</div>
	}
}

type settingItemProps struct {
	Title       string
	ButtonLabel string
	ActionURL   string
}

templ settingItem(props settingItemProps) {
	<div class="flex items-center justify-between border-b border-pale-gray p-2">
		<p class="text-xs font-medium text-neutral-dark">{ props.Title }</p>
		<a
			href={ templ.URL(props.ActionURL) }
			class="cursor-pointer rounded-sm bg-primary px-2 py-1.5 text-xs text-white hover:opacity-75"
		>{ props.ButtonLabel }</a>
	</div>
}
