package pages

import "nearbyassist/views/partials"

templ Login() {
	@partials.Head()
	<div>
		<form action="/login" method="POST">
			username: <input type="text" name="username" id="username"/>
			password: <input type="text" name="password" id="password"/>
			<button type="submit">login</button>
		</form>
	</div>
}
